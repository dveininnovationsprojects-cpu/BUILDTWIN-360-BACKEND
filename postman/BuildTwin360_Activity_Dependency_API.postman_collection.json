            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predecessorId\": 99999,\n  \"successorId\": {{activity_2_id}},\n  \"dependencyType\": \"FS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/activity-dependencies",
              "host": ["{{base_url}}"],
              "path": ["activity-dependencies"]
            },
            "description": "Tests 404 handler when predecessor activity ID does not exist."
          }
        }
