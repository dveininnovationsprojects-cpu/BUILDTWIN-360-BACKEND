    {
      "name": "4. Negative Testing & Business Rules Validation",
      "item": [
        {
          "name": "4.1 Negative: Self-Dependency Validation (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('Error message mentions self-referencing', function () {",
                  "    pm.expect(res.message).to.include('cannot depend on itself');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predecessorId\": {{activity_1_id}},\n  \"successorId\": {{activity_1_id}},\n  \"dependencyType\": \"FS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/activity-dependencies",
              "host": ["{{base_url}}"],
              "path": ["activity-dependencies"]
            },
            "description": "Tests validation preventing an activity from depending on itself."
          }
        },
        {
          "name": "4.2 Negative: Circular Loop Cycle Detection (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('Error message mentions Circular dependency', function () {",
                  "    pm.expect(res.message).to.include('Circular dependency detected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predecessorId\": {{activity_3_id}},\n  \"successorId\": {{activity_1_id}},\n  \"dependencyType\": \"FS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/activity-dependencies",
              "host": ["{{base_url}}"],
              "path": ["activity-dependencies"]
            },
            "description": "Tests cycle detection BFS algorithm preventing circular loops (A -> B -> C -> A)."
          }
        },
        {
          "name": "4.3 Negative: Duplicate Dependency Link (Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predecessorId\": {{activity_1_id}},\n  \"successorId\": {{activity_2_id}},\n  \"dependencyType\": \"FS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/activity-dependencies",
              "host": ["{{base_url}}"],
              "path": ["activity-dependencies"]
            },
            "description": "Tests duplicate prevention constraint between the same predecessor and successor activities."
          }
        },
        {
          "name": "4.4 Negative: Non-Existent Activity (Expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
