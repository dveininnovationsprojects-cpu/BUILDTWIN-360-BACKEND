    {
      "name": "3. Dependency Chain, CPM Network & Cleanup",
      "item": [
        {
          "name": "3.1 Get Activity Dependency Chain & Execution Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('Contains readiness flag isReadyToStart', function () {",
                  "    pm.expect(res.data).to.have.property('isReadyToStart');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/activities/{{activity_2_id}}/dependency-chain",
              "host": ["{{base_url}}"],
              "path": ["activities", "{{activity_2_id}}", "dependency-chain"]
            },
            "description": "Provides full diagnostic view of predecessors, successors, blockers, and whether activity is ready to start (isReadyToStart)."
          }
        },
        {
          "name": "3.2 Get Full Project CPM Dependency Network (Gantt Graph)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('Contains nodes and edges arrays', function () {",
                  "    pm.expect(res.data).to.have.property('nodes');",
                  "    pm.expect(res.data).to.have.property('edges');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
