              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "activity-dependencies", "network"]
            },
            "description": "Returns full network graph (nodes and edges) for Gantt chart, CPM analysis, and interactive flow diagrams."
          }
