{
  "info": {
    "_postman_id": "b360-audit-log-api-v1",
    "name": "BuildTwin 360 - Audit Log API",
    "description": "Enterprise Postman Collection for Audit Log Module in BuildTwin 360.\n\nCovers:\n1. Authentication (Admin Login with Auto Token Save)\n2. List All Audit Logs (Paginated & Sorted)\n3. Get Audit Log by ID\n4. Get Audit Logs by User\n5. Get Audit Logs by Entity Type\n6. Get Audit Logs by Action\n7. Get Audit Logs by Entity & Entity ID\n8. Search Audit Logs (Multi-Criteria Filter & Keyword)\n9. Get Audit Subsystem Statistics & Distribution\n10. Get Audit System Summary\n\nBase URL: {{base_url}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "audit_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "test_username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "test_entity_type",
      "value": "PROJECT",
      "type": "string"
    },
    {
      "key": "test_entity_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "test_action",
      "value": "CREATE_PROJECT",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin) -> Auto Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    console.log('JWT Token successfully set from accessToken: ' + jsonData.data.accessToken);",
                  "} else if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('JWT Token successfully set from token: ' + jsonData.data.token);",
                  "} else if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('JWT Token successfully set: ' + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
