{
  "info": {
    "_postman_id": "b360-module-integration-api-v1",
    "name": "BuildTwin 360 - Module Integration API",
    "description": "Enterprise Postman Collection for Sprint 1 Week 12: Prepare Module Integration APIs in BuildTwin 360.\n\nCovers:\n1. Authentication (Login & Auto Token Save)\n2. Project Module Integration Summary (/api/v1/integration/projects/{projectId}/summary)\n3. Registered Modules & Integration Readiness List (/api/v1/integration/projects/{projectId}/modules)\n4. Project Cross-Module Entity Reference Mapping (/api/v1/integration/projects/{projectId}/cross-references)\n5. Deep Activity Integration Details (/api/v1/integration/activities/{activityId})\n6. System-Wide Module Integration Health Check (/api/v1/integration/health)\n\nBase URL: {{base_url}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "activity_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin) -> Auto Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('JWT Token successfully set: ' + jsonData.data.token);",
                  "} else if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('JWT Token successfully set: ' + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Module Integration APIs",
      "item": [
        {
          "name": "Get Project Module Integration Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integration/projects/{{project_id}}/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integration",
                "projects",
                "{{project_id}}",
                "summary"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Registered Modules and Integration Readiness",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integration/projects/{{project_id}}/modules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integration",
                "projects",
                "{{project_id}}",
                "modules"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Project Cross-Module Entity Reference Mapping",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integration/projects/{{project_id}}/cross-references",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integration",
                "projects",
                "{{project_id}}",
                "cross-references"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Deep Activity Integration Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integration/activities/{{activity_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integration",
                "activities",
                "{{activity_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check System-Wide Module Integration Health",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integration/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integration",
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
