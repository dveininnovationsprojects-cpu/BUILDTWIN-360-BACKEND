        {
          "name": "Add WBS Activity Item to DPR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response && response.data && response.data.activityItems && response.data.activityItems.length > 0) {",
                  "    var lastItem = response.data.activityItems[response.data.activityItems.length - 1];",
                  "    pm.collectionVariables.set('activity_item_id', lastItem.id);",
                  "    console.log('Stored activity_item_id: ' + lastItem.id);",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
