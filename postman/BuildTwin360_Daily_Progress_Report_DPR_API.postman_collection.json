{
  "info": {
    "_postman_id": "b360-daily-progress-report-dpr-v1",
    "name": "BuildTwin 360 - Daily Progress Report (DPR) API Module",
    "description": "Enterprise Postman Collection for Daily Progress Report (DPR), DPR Activity Management & Activity Quantity Tracking in BuildTwin 360.\nCovers:\n0. Authentication & Token Extraction\n1. Daily Progress Report (DPR) Core CRUD & Dashboards\n2. DPR Activity APIs (Add, List, Get by ID, Update, Delete, WBS Activity DPR Progress History)\n3. Activity Quantity Tracking (DPR Summary, Single Activity Analytics, Project-Wide Quantity Tracking Dashboard)\n4. Other Line Items (Labor, Equipment, Materials, Photos)\n5. Review & Approval Workflow (Submit, Approve with WBS cascade, Reject with reason)\n\nBase URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "activity_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "dpr_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "activity_item_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "labor_item_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "equipment_item_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "material_item_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "photo_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "dpr_activity_item_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin) -> Auto Extract JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response && response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set('token', response.data.accessToken);",
                  "    console.log('JWT Token successfully stored in {{token}}');",
                  "}",
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@buildtwin.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Daily Progress Report (DPR) Core",
      "item": [
        {
          "name": "Create Draft DPR (Full Nested Payload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response && response.data && response.data.id) {",
                  "    pm.collectionVariables.set('dpr_id', response.data.id);",
                  "    console.log('Stored created DPR ID: ' + response.data.id);",
                  "}",
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportDate\": \"2026-10-12\",\n  \"shift\": \"DAY_SHIFT\",\n  \"weatherCondition\": \"SUNNY\",\n  \"temperatureCelsius\": 33.5,\n  \"siteEngineer\": \"Engr. Rajesh Kumar\",\n  \"generalNotes\": \"Tower A 4th floor structural slab reinforcement and electrical conduit checking completed. Casting initiated at 11:00 AM.\",\n  \"safetyIncidentsCount\": 0,\n  \"safetyNotes\": \"Toolbox talk conducted on height harness anchor lines & lifeline safety. Zero incidents.\",\n  \"qualityObservations\": \"Slump test 125mm verified against mix design M35. 6 concrete cubes casted.\",\n  \"siteHindrances\": \"Minor grid voltage fluctuation at 02:00 PM; shifted immediately to 125 kVA standby diesel generator.\",\n  \"activityItems\": [\n    {\n      \"activityId\": {{activity_id}},\n      \"quantityToday\": 35.5,\n      \"locationReference\": \"Tower A - Level 4 - Pour A\",\n      \"remarks\": \"Reinforced cement concrete poured with boom pump\"\n    }\n  ],\n  \"laborItems\": [\n    {\n      \"tradeCategory\": \"Masons & Concreters\",\n      \"headcount\": 12,\n      \"hoursWorked\": 8.0,\n      \"subcontractorName\": \"Apex Concrete Works\",\n      \"remarks\": \"Pour screeding and vibrator crew\"\n    }\n  ],\n  \"equipmentItems\": [\n    {\n      \"equipmentName\": \"Concrete Boom Placer (36m)\",\n      \"equipmentCode\": \"EQ-BP-01\",\n      \"quantity\": 1,\n      \"operatingHours\": 6.5,\n      \"idleHours\": 1.0,\n      \"breakdownHours\": 0.0,\n      \"fuelConsumedLiters\": 48.0,\n      \"remarks\": \"Flushed and cleaned pipeline post pour\"\n    }\n  ],\n  \"materialItems\": [\n    {\n      \"materialName\": \"Ready Mix Concrete M35\",\n      \"unitOfMeasure\": \"CUM\",\n      \"quantityReceived\": 35.5,\n      \"quantityConsumed\": 35.5,\n      \"supplierName\": \"UltraTech RMC Plant\",\n      \"challanOrInvoiceNumber\": \"DC-2026-10492\",\n      \"remarks\": \"Batch transit temperature 29C\"\n    }\n  ],\n  \"photoAttachments\": [\n    {\n      \"photoUrl\": \"https://storage.buildtwin360.com/sites/prj1/photos/pour_level4_progress.jpg\",\n      \"caption\": \"Slab concrete casting in progress on Tower A Level 4\",\n      \"category\": \"PROGRESS\",\n      \"takenAt\": \"2026-10-12T11:45:00\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/dpr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{project_id}}",
                "dpr"
              ]
            }
          }
        },
