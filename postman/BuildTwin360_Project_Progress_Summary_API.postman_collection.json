{
  "info": {
    "_postman_id": "b360-project-progress-summary-api-v1",
    "name": "BuildTwin 360 - Project Progress Summary API Module",
    "description": "Enterprise Postman Collection for the Project Progress Summary API Module in BuildTwin 360.\n\nCovers:\n1. Authentication (Login & Auto Token Save)\n2. Project Progress Summary Dashboard (Overall Progress %, Schedule Health, EVM, Quantities, WP & Discipline rollups)\n3. Portfolio-Wide Executive Progress Summary\n4. Work Package Progress Summary Breakdown\n\nBase URL: {{base_url}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "work_package_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin) -> Auto Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('JWT Token successfully set: ' + jsonData.data.token);",
                  "} else if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('JWT Token successfully set: ' + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates with credentials and automatically extracts Bearer JWT token into collection variable 'token'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Project Progress Summary Dashboard",
      "item": [
        {
          "name": "Get Project Progress Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/progress-summary",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "progress-summary"]
            },
            "description": "Retrieves comprehensive executive progress summary for project ID 1 (Overall %, Schedule Health, EVM, activity counts, physical quantities, work package and discipline rollups)."
          },
          "response": []
        },
        {
          "name": "Get Project Progress Summary (Alias URL)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/progress/summary",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "progress", "summary"]
            },
            "description": "Alternative alias endpoint for retrieving project progress summary for project ID 1."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Portfolio-Wide Progress Summary",
      "item": [
        {
          "name": "Get Portfolio Progress Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/progress-summary",
              "host": ["{{base_url}}"],
              "path": ["projects", "progress-summary"]
            },
            "description": "Retrieves high-level executive portfolio progress summary across all registered projects."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Work Package Progress Summary",
      "item": [
        {
          "name": "Get Work Package Progress Summary",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/work-packages/{{work_package_id}}/progress-summary",
              "host": ["{{base_url}}"],
              "path": ["work-packages", "{{work_package_id}}", "progress-summary"]
            },
            "description": "Retrieves progress summary metrics for work package ID 1."
          },
          "response": []
        }
      ]
    }
  ]
}
