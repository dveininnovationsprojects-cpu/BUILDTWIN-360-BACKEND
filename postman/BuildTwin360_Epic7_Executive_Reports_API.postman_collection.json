              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/weekly/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "weekly", "{{project_id}}"]
            }
          }
        },
        {
          "name": "2.2 Invalid Project ID -> 404 Resource Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Error response indicates Project Not Found\", function () {",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/weekly/99999",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "weekly", "99999"]
            }
          }
        }
      ]
    }
  ]
